<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.household.app"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.household.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.household.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.Household" >

        <!-- 앱 실행 시 가장 먼저 뜨는 화면 : 로그인 -->
        <activity
            android:name="com.household.app.LoginActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.household.app.SignupActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.FindIdActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.FindPasswordActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.MyPageActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.ScheduleActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.ScheduleEditActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.ManageActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.BillEditActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.IngredientEditActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.TrashEditActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.TipCategoryActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.TipSubCategoryActivity"
            android:exported="false" />
        <activity
            android:name="com.household.app.TipDetailActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.household.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>