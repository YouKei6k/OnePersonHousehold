<?xml version="1.0" encoding="utf-8"?>
<!--
    공용 하단 네비게이션. 기존에는 화면(activity_home, activity_schedule, activity_manage,
    activity_mypage, activity_tip_list)마다 같은 블록이 복붙되어 있었는데, 아이콘을 넣으면서
    <include> 하나로 합쳤다. 각 항목의 id(navHome 등)는 예전과 동일해서
    각 Activity의 클릭리스너 코드는 그대로 쓸 수 있다. 어떤 탭을 강조할지는
    BottomNavHelper.setActive() 가 자바 코드에서 처리한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/card_white"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:elevation="4dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/nav_home" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavSchedule"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_schedule"
            android:contentDescription="@string/nav_schedule" />

        <TextView
            android:id="@+id/tvNavSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_schedule"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navManage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavManage"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_manage"
            android:contentDescription="@string/nav_manage" />

        <TextView
            android:id="@+id/tvNavManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_manage"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navTip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavTip"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_tip"
            android:contentDescription="@string/nav_tip" />

        <TextView
            android:id="@+id/tvNavTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_tip"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivNavMy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_my"
            android:contentDescription="@string/nav_my" />

        <TextView
            android:id="@+id/tvNavMy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_my"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
