<?xml version="1.0" encoding="utf-8"?>
<!--
    팁 상세 화면 (REQ-013) : 예) 팁-청소-세탁기
    위 : 관리자가 제공하는 팁 내용 / 아래 : 내가 쓴 팁 (추가, 수정, 삭제)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTipPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            tools:text="청소 › 세탁기" />

        <TextView
            android:id="@+id/tvTipTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="세탁기 냄새 관리" />

        <!-- 팁 내용 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_navy"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_tip_content"
                android:textColor="@color/accent_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                tools:text="세탁조는 두 달에 한 번 ..." />
        </LinearLayout>

        <!-- 내가 쓴 팁 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="@string/label_my_tip"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/myTipContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNoMyTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/msg_no_my_tip"
            android:textColor="@color/text_gray"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etMyTip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_edittext"
                android:hint="@string/hint_my_tip_input"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/btnAddMyTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_orange"
                android:text="@string/btn_add_my_tip"
                android:textColor="@color/text_white"
                android:elevation="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
