<?xml version="1.0" encoding="utf-8"?>
<!--
    팁 목록 화면 공용 레이아웃
    - REQ-011 : 팁 종류(카테고리) 버튼 + 검색
    - REQ-012 : 선택한 카테고리의 서브카테고리 버튼 + 검색
    버튼 그리드는 자바 코드에서 한 줄에 3개씩 동적으로 채운다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/title_tip"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTipSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:hint="@string/hint_tip_search"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="20dp" />

            <!-- 버튼 그리드 (자바 코드에서 채움) -->
            <LinearLayout
                android:id="@+id/tipGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/msg_no_tip_result"
                android:textColor="@color/text_gray"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />


</LinearLayout>
