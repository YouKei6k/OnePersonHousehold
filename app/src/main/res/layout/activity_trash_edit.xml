<?xml version="1.0" encoding="utf-8"?>
<!--
    쓰레기 배출 등록/수정 (REQ-010)
    쓰레기 종류(드롭다운) + 사는 지역(시도->시군구->관리구역 3단계) 선택 시
    공공데이터로 배출요일을 조회해 배출일을 자동 계산한다. 조회 실패 시 수동 입력.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="@string/title_trash_add" />

        <!-- 무슨 쓰레기인가 (REQ-010) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/label_trash_type"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spTrashType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext" />

        <!-- 사는 지역/구 : 시도 -> 시군구 -> 관리구역(읍면동) 3단계 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/label_region"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spSido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spSigungu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spArea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext" />

        <!-- 배출일 (자동계산 or 수동) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_disposal_date"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAutoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_navy"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/badge_manual"
                android:textColor="@color/text_white"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDisposalDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:textColor="@color/text_dark"
            tools:text="2026-09-30 (수)" />

        <!-- 자동 <-> 수동 전환 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/tvRecalcAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/btn_recalc_auto"
                android:textColor="@color/accent_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditDateManually"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/btn_edit_date"
                android:textColor="@color/primary_navy"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:text="@string/label_dday"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:hint="@string/hint_noti_dday"
            android:inputType="number" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_orange"
            android:text="@string/btn_register"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:elevation="0dp"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/tvDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/btn_delete"
            android:textColor="@color/error_red"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
